# ==============================================================================
# AI SCRAPPING PIPELINE ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Provider: "gemini", "openai", "groq", or "ollama"
LLM_PROVIDER=gemini

# API Keys (Set the one for your selected provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ollama local configuration (if using local offline models)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=google_genai/gemini-1.5-flash

# Operational Settings
HEADLESS=true
REQUEST_TIMEOUT=15
